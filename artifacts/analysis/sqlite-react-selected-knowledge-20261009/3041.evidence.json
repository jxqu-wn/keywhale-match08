  "original_training_annotation": {
    "question_id": 3041,
    "question": "1992年订购数量最多的书名是什么？",
    "db": "SQLite",
    "query": "SELECT T2.title FROM book_publishing_company.sales AS T1 INNER JOIN book_publishing_company.titles AS T2 ON T1.title_id = T2.title_id WHERE STRFTIME('%Y', T1.ord_date) = '1992' ORDER BY T1.qty DESC LIMIT 1"
