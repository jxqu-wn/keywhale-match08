    "query": "SELECT t.title FROM book_publishing_company.sales s JOIN book_publishing_company.titles t ON s.title_id = t.title_id WHERE strftime('%Y', s.ord_date) = '1992' GROUP BY t.title_id, t.title ORDER BY SUM(s.qty) DESC LIMIT 1"
